<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="160dp" android:layout_height="184dp" android:orientation="vertical"
    android:gravity="center" android:padding="12dp" android:focusable="true" android:clickable="true"
    android:descendantFocusability="blocksDescendants">
    <ImageView android:id="@+id/appIcon" android:layout_width="68dp" android:layout_height="68dp"
        android:scaleType="fitCenter" android:importantForAccessibility="no" />
    <TextView android:id="@+id/appName" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:gravity="center" android:textSize="18sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/appBadge" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:gravity="center" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
