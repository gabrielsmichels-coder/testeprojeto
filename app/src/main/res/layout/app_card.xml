<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="148dp"
    android:orientation="vertical" android:gravity="center" android:padding="10dp"
    android:focusable="true" android:clickable="true" android:descendantFocusability="blocksDescendants">
    <ImageView android:id="@+id/appIcon" android:layout_width="72dp" android:layout_height="72dp"
        android:scaleType="fitCenter" android:importantForAccessibility="no" />
    <TextView android:id="@+id/appName" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:gravity="center" android:textSize="17sp"
        android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
